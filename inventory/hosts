# ============================================
# ANSIBLE INVENTORY - VMware VMs
# Linux Mint + Windows 10
# ============================================

[local]
localhost ansible_connection=local

# ============================================
# LINUX SERVERS (Linux Mint)
# ============================================
[linux_servers]
# VMs con Linux Mint en VMware
# mint-vm1 ansible_host=192.168.137.101 ansible_user=tu-usuario
# mint-vm2 ansible_host=192.168.137.102 ansible_user=tu-usuario

[mint_servers]
# Todas las VMs Linux Mint
# mint-vm1 ansible_host=192.168.137.101 ansible_user=tu-usuario

[ubuntu_servers]
# Si tienes Ubuntu también (Linux Mint es compatible)
# ubuntu-vm1 ansible_host=192.168.137.103

[centos_servers]
# Servidores CentOS/RHEL específicos (si los tienes)

# ============================================
# WINDOWS SERVERS (Windows 10)
# ============================================
[windows_servers]
# VMs con Windows 10 en VMware
# win10-vm1 ansible_host=192.168.137.201
# win10-vm2 ansible_host=192.168.137.202

# ============================================
# GRUPOS DE FUNCIONALIDAD
# ============================================
[web_servers]
# Servidores web (Linux Mint o Windows 10)

[db_servers]
# Servidores de base de datos

[app_servers]
# Servidores de aplicaciones

# ============================================
# GRUPOS PADRES
# ============================================
[all_linux:children]
linux_servers
mint_servers
ubuntu_servers
centos_servers

[all_windows:children]
windows_servers
